# Google Drive (conta de serviço, JSON codificado em base64)
# Gere com: base64 -w 0 caminho/para/service-account.json
GOOGLE_SERVICE_ACCOUNT_B64=
DRIVE_ROOT_FOLDER_ID=id-da-pasta-raiz-no-drive


NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Modo desenvolvimento: pula a exigência de login (Supabase Auth) enquanto
# você ainda não configurou usuários/perfis. NUNCA deixe "true" em produção.
DEV_SKIP_AUTH=true



